# Copy this file to .env.local and fill it in. Never commit .env.local.
# Where each value comes from is explained in docs/setup.md.
# On Vercel, the same names go in Project → Settings → Environment Variables.

# The web address of the site, with no slash at the end.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: the project URL and the anon (public) key. These are safe to show
# in the browser, because row level security protects the data.
# Locally, `supabase status` shows them (API URL and anon key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key: bypasses row level security. Server code only,
# never in the browser, never in chat. Not used yet (comes with emails and
# scheduled jobs).
SUPABASE_SERVICE_ROLE_KEY=

# Direct database connection, for migrations and the database tests only.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Stripe: not needed yet. Paper Fox takes bank transfers only for now, so
# leave these empty until card payments are wanted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend, for sending emails. While this is empty, nothing is sent: the admin
# area lets you preview emails and says sending isn't switched on. Server only.
RESEND_API_KEY=
# Who emails come from, for example "Paper Fox <bookings@paper-fox.co.uk>".
# The domain must be verified in Resend.
EMAIL_FROM="Paper Fox <bookings@paper-fox.co.uk>"
# Local development and the browser tests only: "true" sends every email to
# the local test mailbox (Mailpit, at MAILPIT_URL) instead. Never set this on
# Vercel.
EMAIL_SEND_TO_MAILPIT=

# A long random string that protects the scheduled job endpoints (later phase).
CRON_SECRET=

# Sentry, for error reports with personal data removed (before launch).
SENTRY_DSN=

# Supabase's local test mailbox (Mailpit): sign-in codes, and emails when
# EMAIL_SEND_TO_MAILPIT is "true". Local development and tests only.
MAILPIT_URL=http://127.0.0.1:54324
